# AIVIA environment example.
#
# Copy this file to .env (ignored by git) or export the same names in your
# shell. Fill in only the values you need and never commit real credentials.

# Tool settings.
AIVA_SECRETS_FILE=~/.config/aivia/secrets.env
AIVA_TOKEN_STORE_KEY=<your-token-store-encryption-key>
AIVA_LIVE_BUDGET_USD=0

# Provider credentials are referenced by name from config.yaml. Add one line
# per provider you use; every name must keep the AIVA_ prefix.
# AIVA_OPENAI_API_KEY=<your-openai-api-key>
# AIVA_ANTHROPIC_API_KEY=<your-anthropic-api-key>
# AIVA_ELEVENLABS_API_KEY=<your-elevenlabs-api-key>
